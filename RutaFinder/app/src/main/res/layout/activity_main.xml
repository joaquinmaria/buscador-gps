<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <org.osmdroid.views.MapView android:id="@+id/map" android:layout_width="match_parent" android:layout_height="match_parent"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:orientation="vertical" android:padding="8dp" android:background="#CCFFFFFF">
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cargando..." android:textStyle="bold" android:textColor="#111111"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btnLocation" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Mi posición"/>
            <Button android:id="@+id/btnDestination" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Destino"/>
            <Button android:id="@+id/btnSearch" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Buscar"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btnMap" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Cambiar mapa"/>
            <Button android:id="@+id/btnReload" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Recargar GPX"/>
            <Button android:id="@+id/btnClear" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Limpiar"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
